# Shared ignores (identical base in every Dialectic Playground repository).
# Python tooling (scripts, test runners, docs builds)
__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Repository-specific
# CMake build trees (build/container and build/local in each project)
build/
# Editor tooling outputs
compile_commands.json
.cache/

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
# ...but not the repository's own Makefiles (root and project workspaces)
!/Makefile
!/[0-9][0-9]-*/Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

node_modules/
